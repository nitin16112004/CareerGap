NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=
RUN_QUEUE_WORKERS=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key

REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_PER_IP=20

EMAIL_PROVIDER=console
# Set EMAIL_PROVIDER=gmail and configure these on the Render backend for reminder delivery.
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

BILLING_ENABLED=false
